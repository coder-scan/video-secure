# ==============================================================================
# SECURE VIDEO PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development. Never commit real secrets to Git.
# ==============================================================================

# Application
APP_NAME="Secure Video Infrastructure & Anti-Piracy Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="change-me-to-a-very-long-and-secure-random-secret-key-in-production"
MASTER_ENCRYPTION_KEY="change-me-to-32-byte-hex-encryption-key-for-credentials"

# Server & CORS
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL for Production, SQLite async fallback for local dev)
DATABASE_URL="sqlite+aiosqlite:///./platform.db"
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/secure_video_db"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Security & Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PLAYBACK_TOKEN_EXPIRE_SECONDS=120
HEARTBEAT_INTERVAL_SECONDS=45

# Storage Strategy (LOCAL, S3, R2)
STORAGE_PROVIDER_TYPE="LOCAL"
LOCAL_STORAGE_BASE_PATH="./storage"

# S3 / Cloudflare R2 Settings (Used when STORAGE_PROVIDER_TYPE is S3 or R2)
S3_ENDPOINT_URL=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION_NAME="auto"
S3_BUCKET_NAME="secure-video-platform"

# Default Free Tier Quotas
FREE_TIER_STORAGE_BYTES_LIMIT=5368709120    # 5 GB
FREE_TIER_MAX_VIDEOS=10
FREE_TIER_PROCESSING_MINUTES_LIMIT=120     # 2 hours
FREE_TIER_BANDWIDTH_BYTES_LIMIT=107374182400 # 100 GB
FREE_TIER_MAX_CONCURRENT_STREAMS=1
FREE_TIER_MAX_DEVICES=3
